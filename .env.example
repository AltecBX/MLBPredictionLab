# ---------------------------------------------------------------------------
# Jerry MLB Prediction Lab — environment configuration
# Every variable here is validated at startup; the process refuses to start on
# a malformed required value rather than defaulting silently.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://jerry:jerry@localhost:5432/jerry_mlb
REDIS_URL=redis://localhost:6379/0

# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # json | console
CORS_ORIGINS=http://localhost:3000
GIT_SHA=unknown

# Admin/diagnostics write routes are DISABLED when this is unset,
# never left open.
ADMIN_API_KEY=

# Error tracking. Absent, errors are still logged structurally.
SENTRY_DSN=

# --- Data providers --------------------------------------------------------
# Required categories. Unsetting these stops the application from serving
# predictions rather than degrading silently.
REFERENCE_PROVIDER=mlb_statsapi
SCHEDULE_PROVIDER=mlb_statsapi
RESULTS_PROVIDER=mlb_statsapi

MLB_STATSAPI_BASE_URL=https://statsapi.mlb.com/api/v1
MLB_STATSAPI_TIMEOUT_S=30
MLB_STATSAPI_MIN_INTERVAL_MS=120
MLB_STATSAPI_MAX_RETRIES=4

# Later-phase categories. Leave unset to report them as UNAVAILABLE in the UI;
# they are never filled with placeholder values.
LINEUP_PROVIDER=
STATCAST_PROVIDER=
WEATHER_PROVIDER=
INJURY_PROVIDER=
PARK_FACTOR_PROVIDER=
ODDS_PROVIDER=

# --- Modeling --------------------------------------------------------------
ACTIVE_MODEL_NAME=jerry_logistic
FEATURE_SET_VERSION=fs_v9
MODEL_ARTIFACT_DIR=artifacts/models
PREDICTION_AS_OF_POLICY=T_MINUS_3H   # T_MINUS_3H | T_MINUS_60M | T_MINUS_15M
RANDOM_SEED=20240401
MIN_TRAIN_ROWS=500
BACKTEST_VALIDATION_DAYS=45
MIN_TEAM_GAMES_FOR_PREDICTION=10

# --- Ingestion -------------------------------------------------------------
SCHEDULE_WINDOW_DAYS_BACK=3
SCHEDULE_WINDOW_DAYS_FORWARD=10
RAW_PAYLOAD_RETENTION_DAYS=90

# --- Frontend --------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000/api/v1
